# In dev, leave VITE_API_URL unset — Vite's dev-server proxy forwards /api/*
# to the local Flask backend at 127.0.0.1:5000 (see vite.config.ts), so the
# browser uses a same-origin relative URL and the Pi's LAN IP doesn't matter.
#
# Set this only for a production build that is served from a different host
# than the Flask API (e.g. `npm run build` deployed somewhere off the Pi).
# VITE_API_URL=http://<pi-host>:5000
